# Copia a .env en el servidor (chmod 600). NUNCA subas el .env real. Valores ficticios.
POSTGRES_PASSWORD=cambia-esto-genera-con-openssl-rand-hex-24
# Clave Fernet para cifrar credenciales de brokers. Genera: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Guárdala FUERA de la base de datos y respáldala por separado: sin ella las credenciales guardadas no se pueden descifrar.
CREDENTIAL_ENCRYPTION_KEY=
# true SOLO cuando se sirva por HTTPS con dominio (cookie Secure)
COOKIE_SECURE=false
# Dominio para el perfil Caddy (opcional)
DOMAIN=
# Concurrencia de investigación (VPS 4 GiB: 1)
RESEARCH_WORKERS=1
# Flags de seguridad. El trading real no tiene ruta de código en v1 aunque se pusieran en true.
REAL_TRADING_ENABLED=false
REAL_ORDER_EXECUTION_ENABLED=false
PAPER_AUTO_TRADING_ENABLED=false
PAPER_INITIAL_USDT=100
ALGO_ALLOCATION_FRACTION=0.05
